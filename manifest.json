{
  "manifest_version": 3,
  "name": "YouTube Clip Looper",
  "version": "1.0.0",
  "description": "Save YouTube timestamps as clips and loop them without leaving the video.",
  "permissions": ["storage", "activeTab", "scripting", "commands"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube Clip Looper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "set-start": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+S"
      },
      "description": "Set clip start time"
    },
    "set-end": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+E"
      },
      "description": "Set clip end time"
    },
    "toggle-loop": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+L"
      },
      "description": "Start or stop clip loop"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}